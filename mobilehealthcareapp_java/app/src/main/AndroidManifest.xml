<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.mobilehealthcareapp_java">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mobilehealthcareapp_java">
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:label="@string/title_activity_login">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:label="@string/title_activity_register" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
        </activity>
        <activity
            android:name=".PatientProfileActivity"
            android:exported="false"
            android:label="@string/title_activity_patient_profile" />
        <activity
            android:name=".ProfessionalProfileActivity"
            android:exported="false"
            android:label="@string/title_activity_professional_profile" />
        <activity
            android:name=".ListProfessionalsActivity"
            android:exported="false"
            android:label="@string/title_activity_list_professionals" />
        <activity
            android:name=".ScheduleAppointmentActivity"
            android:exported="false"
            android:label="@string/title_activity_schedule_appointment" />
        <activity
            android:name=".ViewAppointmentsActivity"
            android:exported="false"
            android:label="@string/title_activity_view_appointments" />
        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:label="@string/title_activity_chat" />
        <activity
            android:name=".PaymentActivity"
            android:exported="false"
            android:label="@string/title_activity_payment" />
        <activity
            android:name=".PaymentHistoryActivity"
            android:exported="false"
            android:label="@string/title_activity_payment_history" />

    </application>

</manifest>
